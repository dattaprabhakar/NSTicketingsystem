# !!! IMPORTANT: Add this file to your .gitignore !!!
FLASK_APP=run.py
FLASK_ENV=development # Use 'production' for deployment
SECRET_KEY='a_very_secret_random_key_change_this' # Generate a strong random key

# MongoDB Configuration
MONGO_URI='mongodb://localhost:27017/helpdesk_db' # Replace with your MongoDB connection string

# Email Configuration (Example using Gmail - Requires "App Password" or "Less Secure Apps")
MAIL_SERVER='smtp.gmail.com'
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME='your_email@gmail.com' # Your sender email
MAIL_PASSWORD='your_app_password'      # Your email app password (NOT your main password)
MAIL_DEFAULT_SENDER=('Help Desk', 'your_email@gmail.com') # Display name and sender address